generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Accounts (tables used by Better Auth; names must stay as they are) ───

enum Role {
  COUPLE
  VENDOR
  ADMIN
}

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  /// Empty until the person picks "planning a wedding" or "I'm a vendor".
  roles         Role[]    @default([])
  /// Preferred language: mk | sq | en
  locale        String    @default("mk")
  sessions      Session[]
  accounts      Account[]
  memberships   BusinessMember[]
  /// One wedding per account (decision 59).
  weddingMember WeddingMember?
  /// Email alerts for inquiries, offers and reviews (bell notifications always on).
  emailNotifications Boolean @default(true)
  notifications Notification[]
  inquiryMessages InquiryMessage[]
  reviews       Review[]
  /// Set when the user asks to delete the account (decision 89). Signing in within 30 days clears it; after that the nightly job erases the account.
  deletionRequestedAt DateTime?

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ─── Reference data (managed in the admin panel) ───

model City {
  id        String   @id @default(cuid())
  slug      String   @unique
  nameMk    String
  nameSq    String
  nameEn    String
  region    String?
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  businesses Business[]
  travelFees TravelFee[]
  weddings   Wedding[]

  @@map("city")
}

enum VendorCategoryKey {
  VENUE
  BAND
  PHOTO_VIDEO
}

model VendorCategory {
  id        String            @id @default(cuid())
  key       VendorCategoryKey @unique
  nameMk    String
  nameSq    String
  nameEn    String
  active    Boolean           @default(true)
  sortOrder Int               @default(0)
  updatedAt DateTime          @updatedAt

  @@map("vendor_category")
}

model VenueFeature {
  id        String   @id @default(cuid())
  slug      String   @unique
  nameMk    String
  nameSq    String
  nameEn    String
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  businesses BusinessFeature[]

  @@map("venue_feature")
}

/// Default budget categories copied into each new wedding.
model BudgetTemplateCategory {
  id        String   @id @default(cuid())
  slug      String   @unique
  nameMk    String
  nameSq    String
  nameEn    String
  sortOrder Int      @default(0)
  updatedAt DateTime @updatedAt

  @@map("budget_template_category")
}

/// Default checklist tasks copied into each new wedding.
model ChecklistTemplateItem {
  id           String   @id @default(cuid())
  slug         String   @unique
  titleMk      String
  titleSq      String
  titleEn      String
  /// When the task is due, counted in months before the wedding (0 = final month, -1 = after).
  monthsBefore Int
  sortOrder    Int      @default(0)
  updatedAt    DateTime @updatedAt

  @@map("checklist_template_item")
}

/// Admin-edited "fill typical day" template (decisions 107, 111). One row (id "default"); no row = built-in template in code.
model TypicalDayTemplate {
  id        String           @id @default("default")
  /// "HH:MM"
  startTime String
  steps     TypicalDayStep[]
  updatedAt DateTime         @updatedAt

  @@map("typical_day_template")
}

model TypicalDayStep {
  id          String             @id @default(cuid())
  templateId  String
  template    TypicalDayTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  sortOrder   Int                @default(0)
  titleMk     String
  /// Empty = falls back to titleMk.
  titleSq     String?
  titleEn     String?
  durationMin Int
  /// Tags the plan's event of this type when filling.
  eventType   EventType?
  forAll      Boolean            @default(false)
  forSides    GuestSide[]
  forRoles    GuestRole[]

  @@index([templateId])
  @@map("typical_day_step")
}

model MusicGenre {
  id         String          @id @default(cuid())
  slug       String          @unique
  nameMk     String
  nameSq     String
  nameEn     String
  active     Boolean         @default(true)
  sortOrder  Int             @default(0)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  businesses BusinessGenre[]

  @@map("music_genre")
}

// ─── Vendors ───

enum BusinessStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  HIDDEN
}

enum MemberRole {
  OWNER
  STAFF
}

enum Currency {
  EUR
  MKD
}

/// What a calendar day nobody marked means for this business.
enum UnmarkedDays {
  FREE
  UNKNOWN
}

enum DayStatus {
  FREE
  TENTATIVE
  BOOKED
}

enum DrinksIncluded {
  NONE
  SOFT
  DOMESTIC_UNLIMITED
  CUSTOM
}

enum ExtraUnit {
  PER_PERSON
  FIXED
}

model Business {
  id              String            @id @default(cuid())
  category        VendorCategoryKey
  name            String
  slug            String            @unique
  descriptionMk   String            @default("")
  descriptionSq   String?
  descriptionEn   String?
  /// Location for venues and studios; home city for bands.
  cityId          String?
  city            City?             @relation(fields: [cityId], references: [id], onDelete: SetNull)
  address         String?
  lat             Float?
  lng             Float?
  phone           String?
  viber           String?
  whatsapp        String?
  email           String?
  website         String?
  instagram       String?
  facebook        String?
  /// Bands: instruments / members, free text.
  lineup          String?
  status          BusinessStatus    @default(DRAFT)
  rejectionReason String?
  submittedAt     DateTime?
  approvedAt      DateTime?
  unmarkedDays    UnmarkedDays      @default(UNKNOWN)
  /// Default currency for new prices.
  currency        Currency          @default(EUR)
  /// One-time link for the real owner of an admin-created listing.
  claimToken      String?           @unique
  claimExpiresAt  DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  members         BusinessMember[]
  invites         BusinessInvite[]
  photos          Photo[]
  galleries       PortfolioGallery[]
  videoLinks      VideoLink[]
  halls           Hall[]
  menuPackages    MenuPackage[]
  extras          Extra[]
  servicePackages ServicePackage[]
  travelFees      TravelFee[]
  availability    AvailabilityDay[]
  features        BusinessFeature[]
  genres          BusinessGenre[]
  plannedBy       PlannedVendor[]
  favorites       Favorite[]
  inquiries       Inquiry[]
  reviews         Review[]
  statDays        BusinessStatDay[]
  views           BusinessView[]
  /// Kept in sync with visible reviews, for sorting search results.
  ratingAvg       Float?
  ratingCount     Int               @default(0)

  @@index([category, status])
  @@index([cityId])
  @@map("business")
}

model BusinessMember {
  id         String     @id @default(cuid())
  businessId String
  business   Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId     String
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       MemberRole
  createdAt  DateTime   @default(now())

  @@unique([businessId, userId])
  @@index([userId])
  @@map("business_member")
}

/// Copyable link that adds a staff member.
model BusinessInvite {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  token      String   @unique
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@index([businessId])
  @@map("business_invite")
}

model BusinessFeature {
  businessId String
  business   Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  featureId  String
  feature    VenueFeature @relation(fields: [featureId], references: [id], onDelete: Cascade)

  @@id([businessId, featureId])
  @@map("business_feature")
}

model BusinessGenre {
  businessId String
  business   Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  genreId    String
  genre      MusicGenre @relation(fields: [genreId], references: [id], onDelete: Cascade)

  @@id([businessId, genreId])
  @@map("business_genre")
}

model PortfolioGallery {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  title      String
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  photos     Photo[]

  @@index([businessId])
  @@map("portfolio_gallery")
}

model Photo {
  id         String            @id @default(cuid())
  businessId String
  business   Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  galleryId  String?
  gallery    PortfolioGallery? @relation(fields: [galleryId], references: [id], onDelete: Cascade)
  url        String
  sortOrder  Int               @default(0)
  createdAt  DateTime          @default(now())

  @@index([businessId, sortOrder])
  @@map("photo")
}

model VideoLink {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  url        String
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([businessId])
  @@map("video_link")
}

model Hall {
  id           String            @id @default(cuid())
  businessId   String
  business     Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name         String
  capacityMin  Int?
  capacityMax  Int
  description  String?
  sortOrder    Int               @default(0)
  createdAt    DateTime          @default(now())
  availability AvailabilityDay[]
  inquiries    Inquiry[]

  @@index([businessId])
  @@map("hall")
}

model MenuPackage {
  id             String         @id @default(cuid())
  businessId     String
  business       Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  nameMk         String
  nameSq         String?
  nameEn         String?
  /// Whole currency units.
  pricePerPerson Int
  currency       Currency
  minGuests      Int?
  /// One line per course, in the vendor's language.
  courses        String[]
  drinks         DrinksIncluded @default(NONE)
  drinksNote     String?
  sortOrder      Int            @default(0)
  createdAt      DateTime       @default(now())

  @@index([businessId])
  @@map("menu_package")
}

model Extra {
  id         String    @id @default(cuid())
  businessId String
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  nameMk     String
  nameSq     String?
  nameEn     String?
  price      Int
  currency   Currency
  unit       ExtraUnit @default(FIXED)
  sortOrder  Int       @default(0)
  createdAt  DateTime  @default(now())

  @@index([businessId])
  @@map("extra")
}

/// Packages for bands and photo/video studios.
model ServicePackage {
  id             String   @id @default(cuid())
  businessId     String
  business       Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  nameMk         String
  nameSq         String?
  nameEn         String?
  price          Int
  currency       Currency
  hours          Int?
  /// Bands: number of musicians.
  members        Int?
  extraHourPrice Int?
  /// What's included, one item per line.
  includes       String[]
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())

  @@index([businessId])
  @@map("service_package")
}

/// Band travel fee to a city other than its home city.
model TravelFee {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  cityId     String
  city       City     @relation(fields: [cityId], references: [id], onDelete: Cascade)
  price      Int
  currency   Currency

  @@unique([businessId, cityId])
  @@map("travel_fee")
}

model AvailabilityDay {
  id          String    @id @default(cuid())
  businessId  String
  business    Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  hallId      String?
  hall        Hall?     @relation(fields: [hallId], references: [id], onDelete: Cascade)
  /// hallId, or "main" for businesses without halls (keeps the unique key non-null).
  calendarKey String
  date        DateTime  @db.Date
  status      DayStatus
  updatedAt   DateTime  @updatedAt

  @@unique([businessId, calendarKey, date])
  @@index([businessId, date])
  @@map("availability_day")
}

// ─── Couple planner ───

enum WeddingRole {
  OWNER
  PARTNER
  EDITOR
  VIEWER
}

enum EventType {
  RECEPTION
  BRIDE_HOME
  GROOM_HOME
  ENGAGEMENT
  BACHELORETTE
  CHURCH
  CIVIL
  CUSTOM
}

enum GuestSide {
  BRIDE
  GROOM
  BOTH
}

enum GuestRole {
  BRIDE
  GROOM
  KUM
  KUMA
  STAR_SVAT
  STAROSVATICA
  DEVER
  DEVERUSHA
}

enum AgeGroup {
  CHILD
  YOUNG
  ADULT
  OLDER
}

enum Rsvp {
  PENDING
  YES
  NO
}

enum TableShape {
  LONG
  ROUND
  HEAD
  SQUARE
  ELLIPSE
  HALF_ROUND
  ROW
}

/// Room elements on the seating plan (decision 119).
enum FloorItemKind {
  DANCE_FLOOR
  BAND
  LABEL
  DANCE_FLOOR_ROUND
  STAGE
  TENT
  BUFFET_LONG
  BUFFET_ROUND
  WALL
  DOOR
  PILLAR
  ENTRANCE
  WC
  BAR
  DJ
  CAKE
  GIFTS
  SPEAKER
  LIGHT
  PHOTO
  KIDS
}

enum Payer {
  COUPLE
  BRIDE_FAMILY
  GROOM_FAMILY
  KUM
  OTHER
}

enum CostType {
  FIXED
  PER_PERSON
}

enum PaymentKind {
  DEPOSIT
  INSTALLMENT
  FINAL
}

enum PlannedVendorStatus {
  CONSIDERING
  BOOKED
}

model Wedding {
  id              String    @id @default(cuid())
  partner1        String
  partner2        String
  date            DateTime? @db.Date
  cityId          String?
  city            City?     @relation(fields: [cityId], references: [id], onDelete: SetNull)
  estimatedGuests Int?
  /// Total budget the couple plans to spend, in `currency`.
  budgetTotal     Int?
  currency        Currency  @default(EUR)
  /// Paid plan. Limits only apply when the paywall is switched on (decision 22a).
  premium         Boolean   @default(false)
  /// Invitation picture: shown on RSVP pages and as their link preview.
  invitationUrl   String?
  /// Video invitation (full-screen video with the key details, then the RSVP form). Off until switched on.
  inviteEnabled   Boolean   @default(false)
  /// https link to an MP4/WebM; empty means the sample video.
  inviteVideoUrl  String?
  /// Small line above the names, e.g. "We're getting married".
  inviteHeadline  String?
  inviteMessage   String?
  /// How dark the layer over the video is, 0–80 (%), so the text stays readable.
  inviteOverlay   Int       @default(45)
  /// Events shown on the video invitation (none by default). Each guest still only sees the ones they're invited to.
  inviteEventIds  String[]  @default([])
  /// Read-only from 6 months after the date (decision 90).
  archivedAt        DateTime?
  /// Owners were emailed that guest data will be erased soon (decision 92).
  erasureWarnedAt   DateTime?
  /// Guest list and seating erased 2 years after the date (decision 92).
  guestDataErasedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  members          WeddingMember[]
  invites          WeddingInvite[]
  events           WeddingEvent[]
  households       Household[]
  guests           Guest[]
  tables           SeatingTable[]
  floorItems       FloorItem[]
  budgetCategories BudgetCategory[]
  expenses         Expense[]
  tasks            Task[]
  plannedVendors   PlannedVendor[]
  scheduleDays     ScheduleDay[]
  scheduleItems    ScheduleItem[]
  favorites        Favorite[]
  inquiries        Inquiry[]
  reviews          Review[]

  @@map("wedding")
}

model WeddingMember {
  id        String      @id @default(cuid())
  weddingId String
  wedding   Wedding     @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  userId    String      @unique
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      WeddingRole
  createdAt DateTime    @default(now())

  @@index([weddingId])
  @@map("wedding_member")
}

model WeddingInvite {
  id        String      @id @default(cuid())
  weddingId String
  wedding   Wedding     @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  token     String      @unique
  role      WeddingRole
  expiresAt DateTime
  createdAt DateTime    @default(now())

  @@index([weddingId])
  @@map("wedding_invite")
}

model WeddingEvent {
  id            String            @id @default(cuid())
  weddingId     String
  wedding       Wedding           @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  type          EventType
  /// Custom name; empty means the translated name of `type`.
  name          String?
  date          DateTime?         @db.Date
  /// "HH:MM"
  time          String?
  /// Address, free text.
  place         String?
  /// Optional map pin for the address (decision 103).
  lat           Float?
  lng           Float?
  hasSeating    Boolean           @default(false)
  sortOrder     Int               @default(0)
  createdAt     DateTime          @default(now())
  invitations   GuestInvitation[]
  tables        SeatingTable[]
  floorItems    FloorItem[]
  expenses      Expense[]
  scheduleItems ScheduleItem[]
  inquiries     Inquiry[]

  @@index([weddingId])
  @@map("wedding_event")
}

model Household {
  id          String    @id @default(cuid())
  weddingId   String
  wedding     Wedding   @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  name        String
  side        GuestSide
  /// Unguessable token for the household's RSVP link.
  rsvpToken   String    @unique
  /// Couple's own notes.
  notes       String?
  /// Note the guests left on the RSVP page.
  guestNote   String?
  respondedAt DateTime?
  createdAt   DateTime  @default(now())
  guests      Guest[]

  @@index([weddingId])
  @@map("household")
}

model Guest {
  id          String            @id @default(cuid())
  weddingId   String
  wedding     Wedding           @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  householdId String
  household   Household         @relation(fields: [householdId], references: [id], onDelete: Cascade)
  name        String
  ageGroup    AgeGroup          @default(ADULT)
  /// Wedding-party role (decision 100); most guests have none.
  role        GuestRole?
  sortOrder   Int               @default(0)
  /// Personal RSVP link for this guest only (the household link covers the whole family). Made on first use.
  rsvpToken   String?           @unique
  /// Note and answer time from the guest's personal link.
  guestNote   String?
  respondedAt DateTime?
  createdAt   DateTime          @default(now())
  invitations GuestInvitation[]
  seats       TableSeat[]
  scheduleFor ScheduleItemGuest[]

  @@index([weddingId])
  @@index([householdId])
  @@map("guest")
}

/// A guest invited to an event, with their answer.
model GuestInvitation {
  guestId String
  guest   Guest        @relation(fields: [guestId], references: [id], onDelete: Cascade)
  eventId String
  event   WeddingEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  rsvp    Rsvp         @default(PENDING)

  @@id([guestId, eventId])
  @@index([eventId])
  @@map("guest_invitation")
}

model SeatingTable {
  id        String       @id @default(cuid())
  weddingId String
  wedding   Wedding      @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  eventId   String
  event     WeddingEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name      String
  shape     TableShape
  seats     Int
  /// Position on the floor plan, in plan units (0–1000 × 0–700).
  x         Float        @default(0)
  y         Float        @default(0)
  rotation  Int          @default(0)
  sortOrder Int          @default(0)
  guests    TableSeat[]

  @@index([eventId])
  @@map("seating_table")
}

/// A room element on an event's seating plan: dance floor, band or a labelled box (decision 119). Seats nobody.
model FloorItem {
  id        String        @id @default(cuid())
  weddingId String
  wedding   Wedding       @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  eventId   String
  event     WeddingEvent  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  kind      FloorItemKind
  name      String
  /// Centre and size on the floor plan, in plan units (like tables).
  x         Float
  y         Float
  width     Float
  height    Float
  rotation  Int           @default(0)
  createdAt DateTime      @default(now())

  @@index([eventId])
  @@map("floor_item")
}

/// Which table a guest sits at for one event (per table, not per chair — decision 67).
model TableSeat {
  guestId String
  guest   Guest        @relation(fields: [guestId], references: [id], onDelete: Cascade)
  tableId String
  table   SeatingTable @relation(fields: [tableId], references: [id], onDelete: Cascade)
  /// Same as the table's event; part of the key so a guest has one table per event.
  eventId String

  @@id([guestId, eventId])
  @@index([tableId])
  @@map("table_seat")
}

model BudgetCategory {
  id        String    @id @default(cuid())
  weddingId String
  wedding   Wedding   @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  name      String
  /// Template slug (venue, music…) for categories copied from the defaults.
  slug      String?
  sortOrder Int       @default(0)
  expenses  Expense[]

  @@index([weddingId])
  @@map("budget_category")
}

model Expense {
  id              String         @id @default(cuid())
  weddingId       String
  wedding         Wedding        @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  categoryId      String
  category        BudgetCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name            String
  costType        CostType       @default(FIXED)
  /// FIXED: the planned amount. PER_PERSON: price per adult.
  amount          Int
  /// PER_PERSON only: price per child (empty = same as adults).
  childPrice      Int?
  currency        Currency
  /// PER_PERSON only: which event's guests to count (empty = reception).
  eventId         String?
  event           WeddingEvent?  @relation(fields: [eventId], references: [id], onDelete: SetNull)
  /// PER_PERSON only: use this number of people instead of the guest list.
  guestsOverride  Int?
  payer           Payer          @default(COUPLE)
  plannedVendorId String?
  plannedVendor   PlannedVendor? @relation(fields: [plannedVendorId], references: [id], onDelete: SetNull)
  /// Created from an accepted vendor offer (only once per offer).
  offerId         String?        @unique
  offer           Offer?         @relation(fields: [offerId], references: [id], onDelete: SetNull)
  notes           String?
  sortOrder       Int            @default(0)
  createdAt       DateTime       @default(now())
  payments        Payment[]

  @@index([weddingId])
  @@index([categoryId])
  @@map("expense")
}

model Payment {
  id        String      @id @default(cuid())
  expenseId String
  expense   Expense     @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  kind      PaymentKind @default(DEPOSIT)
  amount    Int
  currency  Currency
  dueDate   DateTime?   @db.Date
  paidAt    DateTime?   @db.Date
  createdAt DateTime    @default(now())

  @@index([expenseId])
  @@map("payment")
}

model Task {
  id           String    @id @default(cuid())
  weddingId    String
  wedding      Wedding   @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  title        String
  /// Bucket in months before the wedding (template values: 12, 11, 9, 7, 4, 2, 0, -1). Null = no time set.
  monthsBefore Int?
  /// Exact date set by the couple; overrides the bucket.
  dueDate      DateTime? @db.Date
  /// Free text so people without an account (mother, кум) can be assigned too.
  assignee     String?
  done         Boolean   @default(false)
  doneAt       DateTime?
  templateSlug String?
  sortOrder    Int       @default(0)
  createdAt    DateTime  @default(now())

  @@index([weddingId])
  @@map("task")
}

/// One day of the timeline (decision 105). Item times run from `startTime` through each item's duration.
model ScheduleDay {
  id        String         @id @default(cuid())
  weddingId String
  wedding   Wedding        @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  date      DateTime?      @db.Date
  /// "HH:MM"
  startTime String         @default("10:00")
  items     ScheduleItem[]

  @@index([weddingId])
  @@map("schedule_day")
}

model ScheduleItem {
  id          String              @id @default(cuid())
  weddingId   String
  wedding     Wedding             @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  dayId       String
  day         ScheduleDay         @relation(fields: [dayId], references: [id], onDelete: Cascade)
  /// Optional event tag; supplies the place and pin when the item has no own place.
  eventId     String?
  event       WeddingEvent?       @relation(fields: [eventId], references: [id], onDelete: SetNull)
  sortOrder   Int                 @default(0)
  /// Main moment of the day: when a day has any, the overview shows only those.
  isMain      Boolean             @default(false)
  durationMin Int                 @default(30)
  title       String
  responsible String?
  place       String?
  /// Who the item is for (decision 106): everyone, whole sides, roles, and/or picked guests.
  forAll      Boolean             @default(false)
  forSides    GuestSide[]
  forRoles    GuestRole[]
  guests      ScheduleItemGuest[]
  createdAt   DateTime            @default(now())

  @@index([dayId])
  @@map("schedule_item")
}

model ScheduleItemGuest {
  itemId  String
  item    ScheduleItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  guestId String
  guest   Guest        @relation(fields: [guestId], references: [id], onDelete: Cascade)

  @@id([itemId, guestId])
  @@index([guestId])
  @@map("schedule_item_guest")
}

/// A vendor in the couple's plan: from the catalog (businessId) or a private entry.
model PlannedVendor {
  id         String              @id @default(cuid())
  weddingId  String
  wedding    Wedding             @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  businessId String?
  business   Business?           @relation(fields: [businessId], references: [id], onDelete: SetNull)
  /// Private entries: name and what they do. Catalog entries copy the business name.
  name       String
  kind       String?
  contact    String?
  status     PlannedVendorStatus @default(CONSIDERING)
  notes      String?
  createdAt  DateTime            @default(now())
  expenses   Expense[]

  @@index([weddingId])
  @@map("planned_vendor")
}

// ─── Marketplace ───

/// A vendor saved by a wedding (shared by everyone on the wedding — decision 76).
model Favorite {
  weddingId  String
  wedding    Wedding  @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@id([weddingId, businessId])
  @@index([businessId])
  @@map("favorite")
}

enum InquiryStatus {
  NEW
  REPLIED
  OFFER_SENT
  BOOKED
  DECLINED
  /// Withdrawn by the couple.
  CANCELLED
}

/// A couple's request to a vendor (decision 78). Open = NEW / REPLIED / OFFER_SENT.
model Inquiry {
  id             String        @id @default(cuid())
  weddingId      String
  wedding        Wedding       @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  businessId     String
  business       Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  eventId        String?
  event          WeddingEvent? @relation(fields: [eventId], references: [id], onDelete: SetNull)
  hallId         String?
  hall           Hall?         @relation(fields: [hallId], references: [id], onDelete: SetNull)
  /// Optional menu or package the couple is interested in: "menu:<id>" / "package:<id>" with its name copied.
  packageRef     String?
  packageName    String?
  date           DateTime?     @db.Date
  guestCount     Int?
  status         InquiryStatus @default(NEW)
  createdById    String?
  lastMessageAt  DateTime      @default(now())
  /// When each side last opened the thread (for unread dots).
  coupleSeenAt   DateTime?
  vendorSeenAt   DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  messages       InquiryMessage[]
  offers         Offer[]

  @@index([weddingId])
  @@index([businessId, status])
  @@map("inquiry")
}

/// One message in an inquiry thread (not real-time chat).
model InquiryMessage {
  id         String   @id @default(cuid())
  inquiryId  String
  inquiry    Inquiry  @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  authorId   String?
  author     User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  fromVendor Boolean
  text       String
  createdAt  DateTime @default(now())

  @@index([inquiryId])
  @@map("inquiry_message")
}

enum OfferUnit {
  TOTAL
  PER_PERSON
}

enum OfferStatus {
  OPEN
  ACCEPTED
  DECLINED
  /// Replaced by a newer offer from the vendor.
  REPLACED
}

/// Vendor's priced offer in an inquiry (decision 79).
model Offer {
  id         String      @id @default(cuid())
  inquiryId  String
  inquiry    Inquiry     @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  price      Int
  unit       OfferUnit
  currency   Currency
  validUntil DateTime?   @db.Date
  note       String?
  status     OfferStatus @default(OPEN)
  authorId   String?
  createdAt  DateTime    @default(now())
  respondedAt DateTime?
  expense    Expense?

  @@index([inquiryId])
  @@map("offer")
}

enum ReviewStatus {
  VISIBLE
  HIDDEN
}

/// Verified review: the wedding had the vendor booked and its date has passed (decisions 16, 81).
model Review {
  id           String       @id @default(cuid())
  businessId   String
  business     Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  weddingId    String
  wedding      Wedding      @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  authorId     String?
  author       User?        @relation(fields: [authorId], references: [id], onDelete: SetNull)
  /// 1–5
  rating       Int
  text         String
  status       ReviewStatus @default(VISIBLE)
  vendorReply  String?
  repliedAt    DateTime?
  reportedAt   DateTime?
  reportReason String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@unique([businessId, weddingId])
  @@index([businessId, status])
  @@map("review")
}

enum NotificationType {
  INQUIRY_NEW
  INQUIRY_MESSAGE
  INQUIRY_CANCELLED
  OFFER_NEW
  OFFER_ACCEPTED
  OFFER_DECLINED
  BOOKED
  DECLINED
  REVIEW_NEW
  REVIEW_REPLY
  REVIEW_REPORTED
}

/// In-app bell notification. Text is built from `type` + `data` in the reader's language.
model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  /// Values for the message, e.g. { business, couple }.
  data      Json             @default("{}")
  /// Path inside the app without the locale, e.g. "/plan/inquiries/abc".
  link      String
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, readAt])
  @@index([userId, createdAt])
  @@map("notification")
}

/// Per-day counters for vendor stats (decision 84).
model BusinessStatDay {
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  date       DateTime @db.Date
  views      Int      @default(0)
  inquiries  Int      @default(0)
  favorites  Int      @default(0)

  @@id([businessId, date])
  @@map("business_stat_day")
}

/// Dedupes profile views: one per visitor per business per day. Old rows can be pruned.
model BusinessView {
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  date       DateTime @db.Date
  /// Hash of the visitor cookie.
  visitor    String

  @@id([businessId, date, visitor])
  @@map("business_view")
}
