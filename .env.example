# ── Database ──
# Local: `pnpm db:up` starts Postgres on port 5434.
# Railway: set to ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgresql://svadba:svadba@localhost:5434/svadba

# ── Auth (Better Auth) ──
# Generate with: openssl rand -base64 48
BETTER_AUTH_SECRET=
# Public URL of the web app (no trailing slash)
BETTER_AUTH_URL=http://localhost:3100

# Google login (optional). Leave empty to hide the Google button.
# Redirect URI to register in Google Cloud: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── First admin (used by `pnpm db:seed`, never overwrites an existing user) ──
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── Email ──
# Order: Resend, then Brevo, then SMTP — the first one configured is used. With none, emails are printed to the
# server console (development). Resend needs a verified domain to email anyone but yourself.
RESEND_API_KEY=
# Brevo (https://www.brevo.com, free 300/day): needs no domain, only a verified sender address.
# Senders & IP → Senders → add the address used in EMAIL_FROM and confirm it. API key: SMTP & API → API keys.
BREVO_API_KEY=
# SMTP, e.g. Gmail (blocked on Railway's Free/Trial/Hobby plans; use Brevo or Resend there): SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=you@gmail.com,
# SMTP_PASS=<16-letter app password from https://myaccount.google.com/apppasswords> (needs 2-step verification).
# With Gmail, EMAIL_FROM must use the same address: EMAIL_FROM="Svadba <you@gmail.com>"
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Svadba <no-reply@example.com>"

# ── Premium ──
# Leave false until a payment provider is chosen (decision 22a). When true, free weddings are limited to 100 guests and no seating plan.
PAYWALL_ENABLED=false

# ── Maps ──
# MapTiler key for map tiles in production (free tier: https://cloud.maptiler.com).
# Leave empty in development: OpenStreetMap tiles are used instead.
NEXT_PUBLIC_MAPTILER_KEY=

# ── Image storage ──
# Leave R2_* empty in development: images are saved to UPLOAD_DIR and served by the app.
UPLOAD_DIR=./uploads
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public URL of the bucket (custom domain or r2.dev URL), no trailing slash
R2_PUBLIC_URL=

# ── Nightly jobs ──
# Protects /api/cron/nightly (archive weddings, erase old guest lists, erase deleted accounts).
# Generate with: openssl rand -hex 32. Without it the route refuses every call.
CRON_SECRET=

# ── Error tracking (Sentry, optional) ──
# Leave empty to turn Sentry off; errors then only go to the server log.
SENTRY_DSN=
# Browser errors; baked in at build time, usually the same value as SENTRY_DSN.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ENVIRONMENT=production
# Only for uploading source maps during the build (optional).
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# ── Database backups (ops/backup, a separate Railway cron service) ──
# A PRIVATE R2 bucket, never the public image bucket. Uses the R2_ACCOUNT_ID / R2_*_KEY values above.
BACKUP_BUCKET=
BACKUP_KEEP_DAYS=30
