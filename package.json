{
  "name": "svadba",
  "private": true,
  "packageManager": "pnpm@9.6.0",
  "engines": { "node": ">=20.9" },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "db:up": "docker compose up -d db",
    "db:generate": "pnpm --filter @svadba/db run generate",
    "db:migrate": "pnpm --filter @svadba/db run migrate",
    "db:deploy": "pnpm --filter @svadba/db run migrate:deploy",
    "db:seed": "pnpm --filter @svadba/db run seed",
    "db:studio": "pnpm --filter @svadba/db run studio",
    "db:pull": "sh scripts/db-pull.sh"
  },
  "devDependencies": {
    "turbo": "2.11.10",
    "typescript": "5.9.3"
  }
}
